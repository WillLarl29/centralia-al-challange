# --- General ---
APP_NAME=CentralIA
ENVIRONMENT=local          # local | production
DOCUMENTS_DIR=../documents
DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:5173,http://localhost,http://localhost:80,http://127.0.0.1

# --- Chunking / retrieval ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5

# --- Providers ---
# EMBEDDINGS_PROVIDER: local (sin credenciales) | oci (producción)
# LLM_PROVIDER: local (fallback extractivo) | oci (producción) | groq (alternativa gratuita)
# VECTORSTORE_PROVIDER: local (sin credenciales) | oracle23ai (producción)
EMBEDDINGS_PROVIDER=local
LLM_PROVIDER=local
VECTORSTORE_PROVIDER=local

# --- OCI Generative AI (solo si EMBEDDINGS_PROVIDER/LLM_PROVIDER=oci) ---
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxxxxxx
OCI_EMBED_MODEL_ID=cohere.embed-multilingual-v3.0
OCI_CHAT_MODEL_ID=cohere.command-r-plus

# --- Groq (solo si LLM_PROVIDER=groq) ---
# Crear API key gratis en https://console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Oracle Autonomous Database 23ai (solo si VECTORSTORE_PROVIDER=oracle23ai) ---
ORACLE_DB_USER=centralia
ORACLE_DB_PASSWORD=changeme
ORACLE_DB_DSN=centralia_high
ORACLE_DB_WALLET_LOCATION=./wallet
ORACLE_DB_WALLET_PASSWORD=changeme
